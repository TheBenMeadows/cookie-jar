# Cloudflare Pages header rules.
#
# Every file under /assets/ carries a content hash in its name, so a given URL's bytes never
# change; a year of immutable caching costs nothing and saves a revalidation round trip per asset
# on every repeat visit. Pages' default for these is `max-age=0, must-revalidate`, which asks the
# origin about all four bundles each time the app is opened.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The icons and the social image are not hashed, so they are cached for a day and revalidated.
/tab.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400

# index.html carries the current asset hashes, so it must never be served stale.
/
  Cache-Control: public, max-age=0, must-revalidate
  Referrer-Policy: no-referrer
