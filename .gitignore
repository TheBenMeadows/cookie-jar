# Both forms: the trailing slash alone does not match a symlink named node_modules, which is how
# one got committed.
node_modules
node_modules/
dist/
.env
.env.local
*.local
.DS_Store

# Internal working notes, not part of the published project. Anchored to the repository root:
# without the leading slash these also match review/brief.md, because this filesystem ignores case.
/BRIEF.md
/HANDOFF.md
/SUBMISSION.md
